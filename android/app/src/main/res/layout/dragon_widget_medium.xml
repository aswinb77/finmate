<?xml version="1.0" encoding="utf-8"?>
<!--
  Dragon Finance Widget — MEDIUM (4×2) — MOOD REWORK
  Full-bleed background image + dragon mascot (right) + spend info (left)
  Mood backgrounds and dragon change based on time + spend %.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <!-- Full-bleed Background Image (mood-based, set dynamically) -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_cozy_red"
        android:scaleType="centerCrop"
        android:contentDescription="Widget background" />

    <!-- Content overlay: Left info + Right dragon -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- LEFT: Spending info -->
        <LinearLayout
            android:id="@+id/spend_info_col"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/dragon_image"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="8dp">

            <!-- Top label -->
            <TextView
                android:id="@+id/spend_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spent Today"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:alpha="0.90"
                android:includeFontPadding="false"
                android:layout_marginBottom="4dp" />

            <!-- Big spending amount -->
            <TextView
                android:id="@+id/amount_big"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textColor="#FFFFFF"
                android:textSize="50sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:layout_marginBottom="8dp" />

            <!-- Wavy underline / limit badge pill -->
            <TextView
                android:id="@+id/limit_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_limit_badge_bg"
                android:text="of ₹2,000 limit"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:alpha="0.85"
                android:layout_marginBottom="14dp" />

            <!-- Bottom mini stats row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- This week -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="THIS WEEK"
                        android:textColor="#FFFFFF"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:alpha="0.70"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/week_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <!-- Transactions -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TXNS"
                        android:textColor="#FFFFFF"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:alpha="0.70"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/txn_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- RIGHT: Dragon mascot — bottom-anchored, extends above widget -->
        <ImageView
            android:id="@+id/dragon_image"
            android:layout_width="150dp"
            android:layout_height="160dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="4dp"
            android:src="@drawable/dragon_happy"
            android:scaleType="fitEnd"
            android:adjustViewBounds="true"
            android:contentDescription="Dragon mascot" />

    </RelativeLayout>

</FrameLayout>
